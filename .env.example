# Database
POSTGRES_USER=noshow
POSTGRES_PASSWORD=noshow
POSTGRES_DB=noshow

# Sender address of the confirmation and reminder emails; shown with the hospital name
MAIL_FROM=randevu@sehirhastanesi.example

# Secret shared by the admin service and the web backend's internal account API.
# The internal API is disabled while it is empty. Generate a value with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# Length of newly generated slots in minutes; 20 while empty
SLOT_MINUTES=

# Host ports; change a value if the port is already in use on your machine.
# Only the website (web frontend and web backend) is reachable from other machines.
DB_PORT=5432
WEB_BACKEND_PORT=8000
WEB_FRONTEND_PORT=5173
OVERBOOKING_SERVICE_PORT=8001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# Admin service; published on 127.0.0.1 only
ADMIN_SERVICE_PORT=8002
